# ============================================================================
# РЕЖИМ РАБОТЫ
# ============================================================================
# True - тестовый режим (ничего не удаляется, только отчет)
# False - реальное удаление/перемещение файлов
DRY_RUN=True

# ============================================================================
# ЛОКАЛЬНЫЕ ПУТИ
# ============================================================================
# Откуда собирать файлы (диск или папка)
LOCAL_MEDIA_SOURCE=C:/
LOCAL_DOCUMENTS_SOURCE=C:/Users

# Куда копировать собранные файлы
LOCAL_MEDIA_DEST=D:/Media_Collection
LOCAL_DOCUMENTS_DEST=D:/Documents_Collection

# Папка для сверки с облаком
COMPARE_LOCAL_FOLDER=D:/Media_Collection

# ============================================================================
# ОБЛАЧНЫЕ ХРАНИЛИЩА (выберите нужное)
# ============================================================================

# --- Mail.ru Cloud ---
CLOUD_LOGIN=your_login@mail.ru
CLOUD_PASSWORD=your_app_password

# --- Яндекс.Диск ---
# Получите OAuth-токен: https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb
CLOUD_YANDEX_TOKEN=your_yandex_oauth_token

# --- Google Drive ---
# Скачайте credentials.json из Google Cloud Console
CLOUD_GOOGLE_CREDENTIALS_FILE=credentials.json

# ============================================================================
# ПАПКИ В ОБЛАКЕ ДЛЯ ОПЕРАЦИЙ
# ============================================================================
# Основная папка (оригиналы)
CLOUD_PRIMARY_FOLDER=/фото

# Вторичная папка (копии для дедупликации)
CLOUD_SECONDARY_FOLDER=/copy/фото

# Папка для сверки с локальной
COMPARE_CLOUD_FOLDER=/фото

# ============================================================================
# БЕЗОПАСНОСТЬ
# ============================================================================
# Папка для перемещения дубликатов перед окончательным удалением
REVIEW_FOLDER=D:/На_проверку